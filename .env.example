# --- Database -----------------------------------------------------------
# PostgreSQL connection string. Any hosted Postgres works (Supabase, Neon, RDS).
# On Supabase use the pooled "Connection pooling" URI for the app and the direct
# URI for `prisma migrate deploy`.
# Local example: postgresql://USER@localhost:5432/lift_tracker
DATABASE_URL=

# Used only by `npm test`. Must point at a THROWAWAY database: the integration
# tests truncate every table between cases.
# Local example: postgresql://USER@localhost:5432/lift_tracker_test
TEST_DATABASE_URL=

# --- TfL API ------------------------------------------------------------
# Optional. The Lift Disruptions v2 feed answers anonymously at 50 requests per
# minute, which is ample for five-minute polling. Register at
# https://api-portal.tfl.gov.uk/ for the 500/minute plan and paste the key here.
# Server-side only: never referenced from browser code.
TFL_APP_KEY=

# --- Collector auth -----------------------------------------------------
# Shared secret required as `Authorization: Bearer <CRON_SECRET>` on
# POST /api/internal/poll-lifts. Generate with: openssl rand -hex 32
# Store the same value in the GitHub Actions secret CRON_SECRET.
CRON_SECRET=

# --- App ----------------------------------------------------------------
# Public base URL, no trailing slash. Used for canonical links and metadata.
# Local example: http://localhost:3000
NEXT_PUBLIC_APP_URL=
